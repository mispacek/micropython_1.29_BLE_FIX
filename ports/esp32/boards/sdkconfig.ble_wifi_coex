# Low-memory BLE + Wi-Fi profile for ESP32_GENERIC_C3 and ESP32_GENERIC_C6.
# Include after sdkconfig.ble so these values override the BLE defaults.
# Ported from mispacek/micropython_BLE_FIX at 403ac1335.

CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y

# Reduce lwIP queues, socket count and TCP buffers.
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_SOCKETS=3
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_TCP_WND_DEFAULT=3072
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=3072

# Reduce peak Wi-Fi buffer allocation.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_RX_BA_WIN=12
